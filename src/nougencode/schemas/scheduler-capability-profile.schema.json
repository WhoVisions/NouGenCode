{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nougencode:scheduler-capability-profile:1",
  "title": "NouGen scheduler capability profile",
  "description": "Measured, provenance-carrying capabilities for one dynamically discovered worker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "observed_at", "worker", "devices", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "observations"],
      "properties": {
        "worker_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string"},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["device_id", "kind", "observations"],
        "properties": {
          "device_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workload_id", "kind", "result", "parameters", "observations"],
        "properties": {
          "workload_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
          "parameters": {"type": "object"},
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/observation"}
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "sha256"],
              "properties": {
                "kind": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
                "media_type": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workload_id", "decision", "evidence_ids"],
        "properties": {
          "workload_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["ROUTE", "CONSTRAIN", "AVOID", "UNKNOWN"]},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "metric", "value", "status", "observed_at", "source", "freshness_ttl_seconds"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "value": {},
        "unit": {"type": "string"},
        "status": {"enum": ["OBSERVED", "UNKNOWN", "STALE"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"enum": ["command", "api", "benchmark", "log", "adapter", "operator"]},
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string"},
            "reference": {"type": "string"}
          }
        },
        "freshness_ttl_seconds": {"type": "number", "minimum": 0},
        "unknown_reason": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "UNKNOWN"}}, "required": ["status"]},
          "then": {
            "required": ["unknown_reason"],
            "properties": {"value": {"type": "null"}}
          }
        }
      ]
    }
  }
}
